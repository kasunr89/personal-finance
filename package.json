  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.0",
    "@neondatabase/serverless": "^1.0.2",
    "@sinclair/typebox": "^0.34.49",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.16",
    "kysely-neon": "^2.0.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
